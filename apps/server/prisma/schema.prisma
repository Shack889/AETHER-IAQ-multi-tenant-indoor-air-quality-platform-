generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  rooms         Room[]
}

model Room {
  id              String    @id @default(cuid())
  name            String
  width_ft        Float     @default(22)
  height_ft       Float     @default(22)
  ceiling_ft      Float     @default(10)
  maxOccupancy    Int       @default(10)
  profile         String    @default("OFFICE_OPEN")
  alertThresholds Json?
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  nodes           Node[]
  createdAt       DateTime  @default(now())
}

model Node {
  id              String    @id @default(cuid())
  nodeId          String    @unique
  name            String    @default("Sensor Node")
  roomId          String?
  room            Room?     @relation(fields: [roomId], references: [id])
  posX            Float?
  posY            Float?
  posZ            Float?
  isOnline        Boolean   @default(false)
  lastSeen        DateTime?
  firmware        String?
  connectivity    String    @default("wifi")
  /// Legacy display field — primary control is mockEnabled + hardwareEnabled.
  /// Kept so existing code (Topbar source label, sim-immutability gate) keeps working.
  dataSource      String    @default("live")
  /// When true, the mock generator publishes synthetic readings for this node.
  mockEnabled     Boolean   @default(false)
  /// When true, real-hardware MQTT messages (4-part topic) are accepted for this node.
  /// When false, ESP32 data is dropped silently.
  hardwareEnabled Boolean   @default(true)
  readings        Reading[]
  processed       ProcessedData[]
  createdAt       DateTime  @default(now())
}

model Reading {
  id            BigInt    @id @default(autoincrement())
  nodeId        String
  node          Node      @relation(fields: [nodeId], references: [nodeId])
  timestamp     DateTime  @default(now())
  pm1_raw       Float?
  pm25_raw      Float
  pm10_raw      Float?
  co2_raw       Float
  tvoc_raw      Float
  temp_bme      Float
  rh_bme        Float
  pressure_hpa  Float?
  temp_scd      Float?
  rh_scd        Float?
  simulated     Boolean   @default(false)

  @@index([nodeId, timestamp])
  @@index([timestamp])
}

model ProcessedData {
  id            BigInt    @id @default(autoincrement())
  nodeId        String
  node          Node      @relation(fields: [nodeId], references: [nodeId])
  timestamp     DateTime  @default(now())
  pm25_filtered Float
  co2_filtered  Float
  voc_filtered  Float
  temp_filtered Float
  rh_filtered   Float
  pm25_corrected Float
  crossValidOk  Boolean

  // Domain II: Reliability scores
  reliability_pm25 Float?
  reliability_co2  Float?
  reliability_voc  Float?

  // Domain III: CELI (kept deps_aqi for backward-compat — equal to celi_score)
  deps_aqi      Int
  celi_score    Float?
  celi_weights  Json?
  epa_aqi       Int
  profile_used  String

  // Domain IV: Pollutant Interaction Burden
  direct_burden        Float?
  interaction_burden   Float?
  total_burden         Float?
  dominant_interaction String?
  interaction_details  Json?

  // Domain V: Temporal Exposure Memory (replaces ced_pm25/ced_co2 — old fields retained)
  temporal_memory_pm  Float?
  temporal_memory_co2 Float?
  temporal_memory_voc Float?
  cognitive_burden    Float?
  recovery_status     String?
  cpis_instantaneous  Float?

  // Layer 3 (legacy — populated for backward compatibility)
  cpis          Int
  ced_pm25      Float
  ced_co2       Float
  thermal_pmv   Float?

  pm25_pred_30m Float?
  co2_pred_30m  Float?
  trend_slope   Float?
  event_type    String?
  event_confidence Float?
  anomaly_score Float?
  occupancy_est Int?
  ventilation_cmd String?
  pid_output    Float?
  who_pass      Boolean?
  epa_pass      Boolean?
  bnaaqs_pass   Boolean?
  ashrae_pass   Boolean?
  well_pass     Boolean?
  reset_pass    Boolean?
  alert_level   Int       @default(0)
  simulated     Boolean   @default(false)

  // Domain VII: Explainability
  explanation_text String?

  @@index([nodeId, timestamp])
  @@index([timestamp])
}

model BaselinePattern {
  id            String    @id @default(cuid())
  nodeId        String
  dayOfWeek     Int
  binIndex      Int
  pm25_avg      Float
  co2_avg       Float
  voc_avg       Float
  sampleCount   Int       @default(0)
  updatedAt     DateTime  @updatedAt

  @@unique([nodeId, dayOfWeek, binIndex])
}

model Alert {
  id            String    @id @default(cuid())
  nodeId        String
  level         Int
  message       String
  parameter     String
  value         Float
  threshold     Float
  acknowledged  Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([nodeId, createdAt])
}

model AlgorithmState {
  id        String   @id @default(cuid())
  nodeId    String   @unique
  state     Json
  updatedAt DateTime @updatedAt
}

model Simulation {
  id              String   @id @default(cuid())
  userId          String
  name            String
  roomConfig      Json
  nodePositions   Json
  occupancySched  Json
  events          Json
  profile         String   @default("OFFICE_OPEN")
  speed           Int      @default(10)
  status          String   @default("created")
  simNodeIds      Json
  startedAt       DateTime?
  pausedAt        DateTime?
  simulatedTime   Float    @default(0)
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

/// Naturally occurring CO₂ washout events. Each clean exponential decline of a
/// room emptying yields one air-change-rate estimate (= λ_CO₂ physical analogue)
/// via OLS of ln(C - C_ext) on time. Grounds the TEM decay rate in observed data.
model DecayEvent {
  id           String   @id @default(cuid())
  nodeId       String
  roomId       String?
  profile_used String
  startedAt    DateTime
  endedAt      DateTime
  durationMin  Float
  c0_ppm       Float
  cEnd_ppm     Float
  cExt_ppm     Float
  ach_est      Float    // estimated air-change rate (per hour) = -slope
  lambda_est   Float    // same quantity, named for TEM correspondence
  r_squared    Float
  nPoints      Int
  simulated    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([nodeId, startedAt])
  @@index([profile_used])
}
