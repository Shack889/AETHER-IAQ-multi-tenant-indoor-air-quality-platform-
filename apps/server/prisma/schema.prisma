generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  rooms         Room[]
}

model Room {
  id              String    @id @default(cuid())
  name            String
  width_ft        Float     @default(22)
  height_ft       Float     @default(22)
  ceiling_ft      Float     @default(10)
  maxOccupancy    Int       @default(10)
  profile         String    @default("OFFICE_OPEN")
  alertThresholds Json?

  // Site metadata — descriptive context for the collection environment.
  // Needed before classroom/home collection so each site's readings carry
  // their physical setting into the report layer. Volume is computed from
  // width_ft × ceiling_ft × height_ft, so it isn't stored here.
  siteType          String?   // 'residential' | 'classroom' | 'office'
  locationLabel     String?   // e.g. 'AIUB Faculty Office, Dhaka'
  ventilationType   String?   // 'natural' | 'mechanical' | 'mixed'
  hasAC             Boolean?
  climateDescriptor String?   // e.g. 'tropical humid'
  occupancyMin      Int?
  occupancyMax      Int?
  mountingNote      String?   // sensor height/location in room

  userId          String
  user            User      @relation(fields: [userId], references: [id])
  nodes           Node[]
  createdAt       DateTime  @default(now())
}

model Node {
  id              String    @id @default(cuid())
  nodeId          String    @unique
  name            String    @default("Sensor Node")
  roomId          String?
  room            Room?     @relation(fields: [roomId], references: [id])
  posX            Float?
  posY            Float?
  posZ            Float?
  isOnline        Boolean   @default(false)
  lastSeen        DateTime?
  firmware        String?
  connectivity    String    @default("wifi")
  /// Legacy display field — primary control is mockEnabled + hardwareEnabled.
  /// Kept so existing code (Topbar source label, sim-immutability gate) keeps working.
  dataSource      String    @default("live")
  /// When true, the mock generator publishes synthetic readings for this node.
  mockEnabled     Boolean   @default(false)
  /// When true, real-hardware MQTT messages (4-part topic) are accepted for this node.
  /// When false, ESP32 data is dropped silently.
  hardwareEnabled Boolean   @default(true)
  readings        Reading[]
  processed       ProcessedData[]
  createdAt       DateTime  @default(now())
}

model Reading {
  id            BigInt    @id @default(autoincrement())
  nodeId        String
  node          Node      @relation(fields: [nodeId], references: [nodeId])
  timestamp     DateTime  @default(now())
  pm1_raw       Float?
  pm25_raw      Float
  pm10_raw      Float?
  co2_raw       Float
  tvoc_raw      Float
  temp_bme      Float
  rh_bme        Float
  pressure_hpa  Float?
  temp_scd      Float?
  rh_scd        Float?
  simulated     Boolean   @default(false)

  @@index([nodeId, timestamp])
  @@index([timestamp])
}

model ProcessedData {
  id            BigInt    @id @default(autoincrement())
  nodeId        String
  node          Node      @relation(fields: [nodeId], references: [nodeId])
  timestamp     DateTime  @default(now())
  pm25_filtered Float
  co2_filtered  Float
  voc_filtered  Float
  temp_filtered Float
  rh_filtered   Float
  pm25_corrected Float
  crossValidOk  Boolean

  // Domain II: Reliability scores
  reliability_pm25 Float?
  reliability_co2  Float?
  reliability_voc  Float?

  // Domain III: CELI (kept deps_aqi for backward-compat — equal to celi_score)
  deps_aqi      Int
  celi_score    Float?
  celi_weights  Json?
  epa_aqi       Int
  profile_used  String

  // Domain IV: Pollutant Interaction Burden
  direct_burden        Float?
  interaction_burden   Float?
  total_burden         Float?
  dominant_interaction String?
  interaction_details  Json?

  // Domain V: Temporal Exposure Memory (replaces ced_pm25/ced_co2 — old fields retained)
  temporal_memory_pm  Float?
  temporal_memory_co2 Float?
  temporal_memory_voc Float?
  cognitive_burden    Float?
  recovery_status     String?
  cpis_instantaneous  Float?

  // Layer 3 (legacy — populated for backward compatibility)
  cpis          Int
  ced_pm25      Float
  ced_co2       Float
  thermal_pmv   Float?

  pm25_pred_30m Float?
  co2_pred_30m  Float?
  trend_slope   Float?

  // Layer 4 v2: Holt damped-trend forecaster with empirical prediction intervals.
  // pm25_pred_30m / co2_pred_30m above are the baseline (persistence+trend) method.
  pm25_pred_30m_v2 Float?
  pm25_pred_lo     Float?
  pm25_pred_hi     Float?
  co2_pred_30m_v2  Float?
  co2_pred_lo      Float?
  co2_pred_hi      Float?
  event_type    String?
  event_confidence Float?
  anomaly_score Float?
  occupancy_est Int?
  ventilation_cmd String?
  pid_output    Float?
  who_pass      Boolean?
  epa_pass      Boolean?
  bnaaqs_pass   Boolean?
  ashrae_pass   Boolean?
  well_pass     Boolean?
  reset_pass    Boolean?
  alert_level   Int       @default(0)
  simulated     Boolean   @default(false)

  // Domain VII: Explainability
  explanation_text String?

  @@index([nodeId, timestamp])
  @@index([timestamp])
}

model BaselinePattern {
  id            String    @id @default(cuid())
  nodeId        String
  dayOfWeek     Int
  binIndex      Int
  pm25_avg      Float
  co2_avg       Float
  voc_avg       Float
  sampleCount   Int       @default(0)
  updatedAt     DateTime  @updatedAt

  @@unique([nodeId, dayOfWeek, binIndex])
}

model Alert {
  id            String    @id @default(cuid())
  nodeId        String
  level         Int
  message       String
  parameter     String
  value         Float
  threshold     Float
  acknowledged  Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([nodeId, createdAt])
}

model AlgorithmState {
  id        String   @id @default(cuid())
  nodeId    String   @unique
  state     Json
  updatedAt DateTime @updatedAt
}

/// Small key/value store for operator-tunable runtime settings (e.g. retentionDays).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Walk-forward backtest results — MAE/RMSE/skill per pollutant, method, and
/// environment profile. Cited directly by the paper; never overwritten.
model ForecastMetric {
  id          String   @id @default(cuid())
  nodeId      String
  pollutant   String
  method      String
  profile     String
  horizonMin  Int      @default(30)
  windowStart DateTime
  windowEnd   DateTime
  n           Int
  mae         Float
  rmse        Float
  /// Skill vs naive persistence: 1 - mae_method / mae_persistence. Null for the persistence rows themselves.
  skill       Float?
  createdAt   DateTime @default(now())

  @@index([nodeId, pollutant, method, createdAt])
}

model Simulation {
  id              String   @id @default(cuid())
  userId          String
  name            String
  roomConfig      Json
  nodePositions   Json
  occupancySched  Json
  events          Json
  profile         String   @default("OFFICE_OPEN")
  speed           Int      @default(10)
  status          String   @default("created")
  simNodeIds      Json
  startedAt       DateTime?
  pausedAt        DateTime?
  simulatedTime   Float    @default(0)
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

/// Naturally occurring CO₂ washout events. Each clean exponential decline of a
/// room emptying yields one air-change-rate estimate (= λ_CO₂ physical analogue)
/// via OLS of ln(C - C_ext) on time. Grounds the TEM decay rate in observed data.
model DecayEvent {
  id           String   @id @default(cuid())
  nodeId       String
  roomId       String?
  profile_used String
  startedAt    DateTime
  endedAt      DateTime
  durationMin  Float
  c0_ppm       Float
  cEnd_ppm     Float
  cExt_ppm     Float
  ach_est      Float    // estimated air-change rate (per hour) = -slope
  lambda_est   Float    // same quantity, named for TEM correspondence
  r_squared    Float
  nPoints      Int
  simulated    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([nodeId, startedAt])
  @@index([profile_used])
}

/// Manual occupancy + context log. The INDEPENDENT ground truth for validating
/// occupancy-influenced scores (gates hypothesis H1: CELI vs EPA-AQI must be
/// tested against human-observed occupancy, never the CO₂-derived occupancy_est,
/// or the comparison is circular). Stored separately and never overwritten by
/// occupancy_est. `source` is always 'manual' for human entries; analysis joins
/// these rows to readings by time. Relations are kept loose (nodeId/roomId as
/// plain strings, not FKs) to match how readings are keyed and to avoid blocking
/// a log entry when a room isn't set — existence is validated in the route.
model OccupancyLog {
  id         String   @id @default(cuid())
  nodeId     String?
  roomId     String?
  userId     String
  timestamp  DateTime            // when the observation applies (user-set, to the minute)
  count      Int?                // approximate person count (nullable: "empty" = 0, unknown = null)
  activity   String?             // free/short context e.g. "lecture", "empty", "single occupant"
  eventTag   String?             // structured context annotation, see ALLOWED_EVENT_TAGS
  note       String?             // optional free text
  source     String   @default("manual")
  createdAt  DateTime @default(now())

  @@index([nodeId, timestamp])
  @@index([roomId, timestamp])
}
